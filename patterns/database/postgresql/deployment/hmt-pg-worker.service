[Unit]
Description=Fixed peer-bound PostgreSQL reference worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hmt-pg
Group=hmt-pg
EnvironmentFile=/etc/hmt-pg/launcher.env
ExecStart=/opt/hmt/tailcat-0.7.0 serve --key=/var/lib/hmt-pg/server.private.json --allow=${HMT_PEER_KEY} exec -- /opt/hmt/pg/.venv/bin/python -m hmt_pg_patterns.worker --config /etc/hmt-pg/worker.json
WorkingDirectory=/opt/hmt/pg
StateDirectory=hmt-pg
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
TasksMax=128
MemoryMax=512M
CPUQuota=200%
LimitNOFILE=256
TimeoutStopSec=10
KillMode=control-group
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
