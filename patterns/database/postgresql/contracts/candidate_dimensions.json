{
  "schema_id": "urn:hmt:pg:candidate-dimensions:1.0.0",
  "bounds": {
    "max_dimension_items": 32,
    "max_candidate_rows": 4096
  },
  "invariants": [
    {
      "id": "PG-CONFIG-001",
      "requirement": "PG-CONFIG-001",
      "description": "Connection configuration preserves production TLS and bounded loopback test admission.",
      "failure_modes": [
        "FM-SECURITY"
      ]
    },
    {
      "id": "PG-QUERY-001",
      "requirement": "PG-QUERY-001",
      "description": "Values are bound and dynamic identifiers are admitted before SQL execution.",
      "failure_modes": [
        "FM-INJECTION"
      ]
    },
    {
      "id": "PG-TX-001",
      "requirement": "PG-TX-001",
      "description": "A failed owned transaction leaves no partial database effect.",
      "failure_modes": [
        "FM-PARTIAL"
      ]
    },
    {
      "id": "PG-RETRY-001",
      "requirement": "PG-RETRY-001",
      "description": "Only known transaction-abort SQLSTATEs retry, within a finite attempt budget.",
      "failure_modes": [
        "FM-RETRY"
      ]
    },
    {
      "id": "PG-CLOSE-001",
      "requirement": "PG-CLOSE-001",
      "description": "Async connection teardown finishes within its configured deadline.",
      "failure_modes": [
        "FM-RESOURCE"
      ]
    },
    {
      "id": "PG-CONTRACT-001",
      "requirement": "PG-CONTRACT-001",
      "description": "Strict telemetry contracts reject malformed or unbounded inputs before persistence.",
      "failure_modes": [
        "FM-CONTRACT",
        "FM-RESOURCE"
      ]
    },
    {
      "id": "PG-SNAPSHOT-001",
      "requirement": "PG-SNAPSHOT-001",
      "description": "An authority snapshot is deeply immutable and detached from caller-owned values.",
      "failure_modes": [
        "FM-MUTATION"
      ]
    },
    {
      "id": "PG-FENCE-001",
      "requirement": "PG-FENCE-001",
      "description": "Effect, outbox, and epoch verification share an atomic PostgreSQL transaction.",
      "failure_modes": [
        "FM-EPOCH"
      ]
    },
    {
      "id": "PG-OUTBOX-001",
      "requirement": "PG-OUTBOX-001",
      "description": "Publication failures leave durable replayable work, without repeating the effect.",
      "failure_modes": [
        "FM-REPLAY"
      ]
    },
    {
      "id": "PG-CHECKPOINT-001",
      "requirement": "PG-CHECKPOINT-001",
      "description": "Durable checkpoints advance monotonically and Redis cannot authorize effects.",
      "failure_modes": [
        "FM-REGRESSION"
      ]
    },
    {
      "id": "PG-CDC-001",
      "requirement": "PG-CDC-001",
      "description": "Streaming preserves bytes independently of input packet boundaries and enforces limits.",
      "failure_modes": [
        "FM-PACKET",
        "FM-RESOURCE"
      ]
    },
    {
      "id": "PG-PACE-001",
      "requirement": "PG-PACE-001",
      "description": "Terminal forbids authority and recovery needs explicit reconciliation evidence.",
      "failure_modes": [
        "FM-EPOCH",
        "FM-RECOVERY"
      ]
    },
    {
      "id": "PG-OPS-001",
      "requirement": "PG-OPS-001",
      "description": "Durable local commit is admitted only when observed PostgreSQL WAL prerequisites are enabled; no storage power-loss proof is implied.",
      "failure_modes": [
        "FM-DURABILITY"
      ]
    },
    {
      "id": "PG-POOL-001",
      "requirement": "PG-POOL-001",
      "description": "A finite connection pool rejects excess concurrent leases within its timeout.",
      "failure_modes": [
        "FM-RESOURCE"
      ]
    },
    {
      "id": "PG-MIGRATION-001",
      "requirement": "PG-MIGRATION-001",
      "description": "Applied migration bytes are bound to an immutable checksum and drift cannot execute.",
      "failure_modes": [
        "FM-MUTATION"
      ]
    },
    {
      "id": "PG-PEER-001",
      "requirement": "PG-PEER-001",
      "description": "Trusted Tailcat child peer identity is matched to one fixed database login before payload use.",
      "failure_modes": [
        "FM-PEER"
      ]
    }
  ],
  "failure_modes": [
    {
      "id": "FM-SECURITY",
      "requirement": "An unsafe connection profile or malformed endpoint enters the boundary."
    },
    {
      "id": "FM-INJECTION",
      "requirement": "SQL syntax is supplied through a value or an unapproved identifier."
    },
    {
      "id": "FM-PARTIAL",
      "requirement": "Execution faults after beginning an effect but before durable completion."
    },
    {
      "id": "FM-RETRY",
      "requirement": "A retryable or unknown error attempts to exceed bounded work."
    },
    {
      "id": "FM-RESOURCE",
      "requirement": "A connection or streaming source exceeds the declared resource budget."
    },
    {
      "id": "FM-CONTRACT",
      "requirement": "Malformed fields, nonfinite values, or unknown fields cross the contract."
    },
    {
      "id": "FM-MUTATION",
      "requirement": "Caller mutation changes the state after validation."
    },
    {
      "id": "FM-EPOCH",
      "requirement": "An obsolete authority epoch or wrong peer attempts a write."
    },
    {
      "id": "FM-REPLAY",
      "requirement": "A work item or uncertain acknowledgment is replayed."
    },
    {
      "id": "FM-REGRESSION",
      "requirement": "A checkpoint tries to move backward or substitute cache authority."
    },
    {
      "id": "FM-PACKET",
      "requirement": "Input packet boundaries change without changing the source bytes."
    },
    {
      "id": "FM-RECOVERY",
      "requirement": "Connectivity returns before reconciliation and authority guards hold."
    },
    {
      "id": "FM-DURABILITY",
      "requirement": "Required fsync, full-page writes, or synchronous commit protection is disabled."
    },
    {
      "id": "FM-PEER",
      "requirement": "Transport child peer identity or its bound database role does not match the trusted host binding."
    }
  ],
  "gates": [
    {
      "id": "G-INPUT",
      "requirement": "Admit a bounded typed input or reject before external effects."
    },
    {
      "id": "G-TRANSACTION",
      "requirement": "Commit only the checked epoch, effect, and outbox atomically."
    },
    {
      "id": "G-DELIVERY",
      "requirement": "Retain or acknowledge replayable work and monotonic checkpoints."
    },
    {
      "id": "G-RECOVERY",
      "requirement": "Stop within a bound and restore authority only with explicit guards."
    }
  ],
